{
  "name": "deals-map-app",
  "version": "1.0.0",
  "description": "تطبيق عروض وخدمات مع خريطة تفاعلية وملاح GPS",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "server:build": "echo 'Server built'",
    "client:build": "cd client && npm run build",
    "build": "npm run client:build",
    "start": "node server/index.js",
    "test": "jest"
  },
  "keywords": [
    "deals",
    "services",
    "map",
    "gps",
    "navigation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.3.4",
    "geolocation-utils": "^1.2.0",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "concurrently": "^8.0.1",
    "jest": "^29.5.0"
  }
}
